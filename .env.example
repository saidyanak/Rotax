# Rotax Environment Variables Example
# Bu dosyayı .env olarak kopyala ve değerleri doldur

# Database
POSTGRES_DB=rotax
POSTGRES_USER=rotax
POSTGRES_PASSWORD=your_secure_password_here

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=your_rabbitmq_password_here

# JWT (Base64 encoded - en az 256 bit)
# Üretmek için: echo -n "your-secret-key" | base64
JWT_SECRET=your_base64_encoded_jwt_secret_here
JWT_EXPIRATION=86400000

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Frontend
FRONTEND_URL=http://localhost:3000
