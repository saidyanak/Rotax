# ===========================================
# ROTAX BACKEND ENVIRONMENT CONFIGURATION
# ===========================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env-example .env

# -------------------------------------------
# PostgreSQL Database Configuration
# -------------------------------------------
POSTGRES_DB=rotax
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rotax_secure_password_123

# -------------------------------------------
# Spring Boot Database Connection
# -------------------------------------------
# Docker Compose kullanırken host olarak 'db' kullanın
DATABASE_URL=jdbc:postgresql://db:5432/rotax
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=rotax_secure_password_123

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# Minimum 32 karakter uzunluğunda güvenli bir secret key
JWT_SECRET=rotax_jwt_secret_key_min_32_chars_here

# -------------------------------------------
# Email Configuration (Gmail SMTP)
# -------------------------------------------
# Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
FRONTEND_URL=http://localhost:3000

# -------------------------------------------
# Internal API Key (Servisler arası iletişim)
# -------------------------------------------
INTERNAL_API_KEY=rotax-internal-api-key-change-in-production

# -------------------------------------------
# RabbitMQ Configuration
# -------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/